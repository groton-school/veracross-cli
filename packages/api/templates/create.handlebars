import { operations } from '#spec/{{spec}}';
import { client } from '#{{api}}/client.js';
import { EndpointOptions } from '#types/EndpointOptions.js';

{{#if scope}}
export const CREATE_SCOPE = '{{scope}}';
{{/if}}

/** {{operation.summary}} */
export async function create({ {{#if params.path.length}}{{#each params.path}}
    {{this}},{{/each}}{{/if}}
    data,
    ...rest
}: EndpointOptions<operations, '{{operation.operationId}}'>): Promise<number|undefined> {
    const { data: {data: { id } = {}} = {},  error } = await client().POST('{{endpoint}}', {
        params: { {{#if params.path.length}}path: { {{#each params.path}}{{this}}, {{/each}} }, {{/if}}...rest },
        body: { data }
    });
    if (error) {
        throw new Error('Error creating {{typeName}}', { cause: error });
    }
    return id;
}