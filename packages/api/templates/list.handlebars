import { operations } from '#spec/{{spec}}';
import { client, defaults } from '#{{api}}/client.js';
import { EndpointOptions } from '#types/EndpointOptions.js';
import { ResponseData } from '#types/ResponseBody.js';

{{#if scope}}
export const LIST_SCOPE = '{{scope}}';
{{/if}}

export type {{typeName}}Collection = ResponseData<operations, '{{operation.operationId}}'>;

/** {{operation.summary}} */
export async function list({ {{#if params.path.length}}{{#each params.path}}
    {{this}}, {{/each}}{{/if}}
    header,
    ...rest
}: EndpointOptions<operations, '{{operation.operationId}}'>): Promise<{{typeName}}Collection> {
    const collection: {{typeName}}Collection = [];
    let page = !!header && header['X-Page-Number'] ?
        header['X-Page-Number'] :
        1;
    const page_size = !!header && header['X-Page-Size'] ?
        header['X-Page-Size'] :
        defaults().DEFAULT_PAGE_SIZE;
    let done: boolean;
    do {
        const {data,error} = await client().GET('{{endpoint}}', {
            params: {
                {{#if params.path.length}}path : { {{#each params.path}}{{this}}, {{/each}} },
                {{/if}}
                header: {
                    ...header,
                    'X-Page-Number': page,
                    'X-Page-Size': page_size
                },
                ...rest
            }
        });
        if (error) {
            throw new Error(
                `Error list of {{typeName}} at page ${page}`,
                { cause: error }
            );
        }
        collection.push(...data.data);
        page++;
        done = data.data.length < page_size;
    } while (!done);
    return collection;
}