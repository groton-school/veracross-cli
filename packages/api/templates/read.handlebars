import { operations } from '#spec/{{spec}}';
import { client } from '#{{api}}/client.js';
import { EndpointOptions } from '#types/EndpointOptions.js';
import { ResponseData } from '#types/ResponseBody.js'

{{#if scope}}
export const READ_SCOPE = '{{scope}}';
{{/if}}

export type {{typeName}} = ResponseData<operations, '{{operation.operationId}}'>;

/** {{operation.summary}} */
export async function read({ {{#if params.path.length}}{{#each params.path}}
    {{this}}, {{/each}}{{/if}}
    ...rest
}: EndpointOptions<operations, '{{operation.operationId}}'>): Promise<{{typeName}}> {
    const {data,error} = await client().GET('{{endpoint}}', {
        params: { {{#if params.path.length}}path: { {{#each params.path}}{{this}}, {{/each}} }, {{/if}}...rest }
    });
    if (error) {
        throw new Error('Error retrieving {{typeName}}', { cause: error });
    }
    return data.data;
}