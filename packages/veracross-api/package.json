{
  "name": "@groton/veracross-api",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/groton-school/veracross-cli/tree/main/packages/veracross-api#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/groton-school/veracross-cli.git",
    "directory": "packages/veracross-api"
  },
  "license": "ISC",
  "author": {
    "name": "Seth Battis",
    "email": "sbattis@groton.org"
  },
  "type": "module",
  "imports": {
    "#*": "./dist/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "run-s build:**",
    "build:scripts:clean": "del ./build",
    "build:scripts": "tsc -p ./tsconfig.scripts.json",
    "build:data": "del ./src/Authorization ./src/Data ./src/Files",
    "build:generate": "./scripts/generate",
    "build:compile": "tsc",
    "prepack": "run-s build",
    "release": "commit-and-tag-version --noBumpWhenEmptyChanges",
    "spec": "run-s spec:*",
    "spec:clean": "run-p spec:clean:**",
    "spec:clean:files": "del ./spec",
    "spec:clean:types": "del ./src/spec",
    "spec:files": "run-p spec:files:**",
    "spec:files:auth": "download \"https://stoplight.io/api/v1/projects/veracross/docs/nodes/reference/Authorization-API.yaml\" -o ./spec/",
    "spec:files:data": "download \"https://stoplight.io/api/v1/projects/veracross/docs/nodes/reference/Data-API.yaml\" -o ./spec/",
    "spec:files:files": "download \"https://stoplight.io/api/v1/projects/veracross/docs/nodes/reference/Files-API.yaml\" -o ./spec/",
    "spec:types": "run-p spec:types:**",
    "spec:types:auth": "openapi-typescript ./spec/Authorization-API.yaml -o ./src/spec/Authorization-API.ts",
    "spec:types:data": "openapi-typescript ./spec/Data-API.yaml -o ./src/spec/Data-API.ts",
    "spec:types:files": "openapi-typescript ./spec/Files-API.yaml -o ./src/spec/Files-API.ts"
  },
  "dependencies": {
    "@battis/typescript-tricks": "catalog:",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0"
  },
  "devDependencies": {
    "@battis/workspace": "^0.0.12",
    "@qui-cli/colors": "^3.2.5",
    "@qui-cli/core": "^6.0.4",
    "@qui-cli/plugin": "^4.2.0",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "^24.19.0",
    "change-case": "^5.4.4",
    "del-cli": "catalog:",
    "download-cli": "^1.1.1",
    "handlebars": "^4.7.9",
    "npm-run-all": "catalog:",
    "ora": "^9.4.1",
    "typescript": "catalog:",
    "yaml": "^2.9.1"
  }
}
